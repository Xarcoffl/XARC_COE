# ==============================================================================
# AR/VR Centre of Excellence - Environment Variables Template
# Copy this file to .env.local for local overrides:
# cp .env.example .env.local
# ==============================================================================

# Server Port (default: 3000, recommended development: 3005)
PORT=3005

# JWT Secret for Administrative Sessions (Change to a secure random string in production)
JWT_SECRET=arvr-coe-pec-super-secret-jwt-key-2026

# Node Environment (development / production / test)
NODE_ENV=development
