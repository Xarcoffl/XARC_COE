# ==============================================================================
# AR/VR Centre of Excellence - Environment Variables Template
# Copy this file to .env.local for local overrides:
# cp .env.example .env.local
# ==============================================================================

# Server Port (default: 3000, recommended development: 3005)
PORT=3005

# JWT Secret for Administrative Sessions (Change to a secure random string in production)
JWT_SECRET=arvr-coe-pec-super-secret-jwt-key-2026

# Node Environment (development / production / test)
NODE_ENV=development

# Canonical Public Website URL (Used by sitemap.xml and OpenGraph social cards)
NEXT_PUBLIC_SITE_URL=https://arvr.coe.edu

# ==============================================================================
# Production Database Configuration (MongoDB Atlas)
# Leave blank to use the embedded atomic JSON datastore (data/db.json) as fallback.
# ==============================================================================
MONGODB_URI=
MONGODB_DB=arvr_coe

# ==============================================================================
# Outbound SMTP Email Configuration (Automated Student Status Notifications)
# Supports Gmail, Google Workspace, Outlook / Office 365, AWS SES, or any custom SMTP
# ==============================================================================
# SMTP Host (e.g., smtp.gmail.com, smtp.office365.com, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Secure flag (true for 465, false for 587)
SMTP_SECURE=true

# SMTP Username / Sender Email (e.g., xarcoffl@gmail.com or your Google Workspace address)
SMTP_USER=

# SMTP Password (For Gmail, generate a 16-character 'App Password' via Google Account Security)
SMTP_PASS=

# Sender Display Name and Address (Optional, defaults to SMTP_USER)
EMAIL_FROM="AR/VR Centre of Excellence <xarcoffl@gmail.com>"

